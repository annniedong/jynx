// jynx · strudel syntax · <CR> evaluate · gs = knob · <Space>v visuals · <Space>k keyboard
setcpm(118/4)

drums: s("bd*2 [~ sd] <hh*4 hh*8> ~")
  .gain(.9)
  .room(.15)

hats: s("[~ hh]*4 cp(3,8)")
  .hpf(4000)
  .pan(.7)
  .gain(.5)

bass: note("<c2 eb2 g1 bb1>*2 [c2 c3]")
  .s("supersaw")
  .lpf(slider(700, 100, 4000))
  .lpq(5)
  .delay(.25)
  .gain(.7)

_chords: n("<[0,2,4] [-1,1,3]> ~ ~ [~ 4]").scale("C4:minor")
  .s("bell")
  .room(.5)

// the laptop keyboard plays this one: <Space>k
keys: note("~")
  .s("triangle")
  .lpf(2400)
  .delay(.3)
  .room(.3)
